{
  "name": "gonzalez-mobile-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "scripts": {
    "dev:mobile": "cd apps/mobile && expo start",
    "dev:server": "cd apps/server && next dev",
    "dev": "turbo run dev",
    "build": "cd apps/server && npm run build",
    "start": "cd apps/server && npm start",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "is-arrayish": "^0.3.4",
    "semver": "^7.7.2"
  }
}
