{
  "name": "gonzalez-mobile-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "scripts": {
    "dev:mobile": "cd apps/mobile && expo start",
    "dev:server": "cd apps/server && npm run dev",
    "dev:worker": "cd apps/server && npm run dev:worker",
    "dev": "turbo run dev",
    "build": "cd apps/server && npm run build",
    "start": "cd apps/server && npm start",
    "start:web": "cd apps/server && npm run start:web",
    "worker:reports": "cd apps/server && npm run worker:reports",
    "lint": "turbo run lint",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "is-arrayish": "^0.3.4",
    "semver": "^7.7.2",
    "expo": "~54.0.23",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "version": "1.0.0"
}
