{
  "name": "gonzalez-mobile-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "scripts": {
    "dev:mobile": "cd apps/mobile && expo start",
    "dev:server": "cd apps/server && next dev",
    "dev": "turbo run dev",
    "build": "cd apps/server && npm run build",
    "start": "cd apps/server && npm start",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-webview": "^13.16.0"
  }
}
