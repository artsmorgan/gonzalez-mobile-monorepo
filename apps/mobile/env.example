# API Server Configuration
# Copy this file to .env.local for local development (optional)

# Production API (used in Railway)
# EXPO_PUBLIC_API_SERVER=https://api-gonzalez-mobile-monorepo-production.up.railway.app

# Local Development API (optional - defaults to ngrok URL in app.config.js)
# EXPO_PUBLIC_API_SERVER=http://localhost:3000
# or
# EXPO_PUBLIC_API_SERVER=https://your-ngrok-url.ngrok-free.app

# App Mode
# APP_MODE=dev
# or
# APP_MODE=production

# ---------------------------------------------------------------------------
# Guardify (APK de pruebas). Con el perfil de EAS `guardify-pruebas` NO hace falta nada de esto: el perfil ya lo trae
# (apps/mobile/eas.json). Solo si compilas SIN ese perfil (build local, `expo run:android`, gradle) ponlo en tu .env.
# Sin EXPO_PUBLIC_GUARDIFY_ENABLED=true la app no registra el equipo ni muestra la pantalla de Guardify, pero el servidor de
# pruebas igual exige el equipo aprobado: el login se ve normal y después sale «Equipo no registrado».
# ---------------------------------------------------------------------------
# APP_VARIANT=lite
# EXPO_PUBLIC_API_SERVER=https://api-gonzalez-mobile-monorepo-production.up.railway.app
# EXPO_PUBLIC_GUARDIFY_ENABLED=true
# EXPO_PUBLIC_GUARDIFY_URL=https://guardifyconsole-production.up.railway.app
# EXPO_PUBLIC_GUARDIFY_APP_KEY=monitoreapp
# EXPO_PUBLIC_GUARDIFY_COMPANY_CODE=corporacion-gonzalez
# EXPO_PUBLIC_GUARDIFY_HEARTBEAT_SECONDS=60
