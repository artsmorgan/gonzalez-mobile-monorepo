{
  "cli": {
    "version": ">= 3.20.0"
  },
  "build": {
    "preview": {
      "extends": "preview-lite",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleLiteRelease"
      },
      "env": {
        "APP_VARIANT": "lite"
      }
    },
    "preview-lite": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleLiteRelease"
      },
      "env": {
        "APP_VARIANT": "lite"
      }
    },
    "preview-full": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleFullRelease"
      },
      "env": {
        "APP_VARIANT": "full"
      }
    },
    "preview-prod": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProdRelease"
      },
      "env": {
        "APP_VARIANT": "prod"
      }
    },
    "production": {
      "extends": "production-lite",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleLiteRelease"
      },
      "env": {
        "APP_VARIANT": "lite"
      }
    },
    "production-lite": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleLiteRelease"
      },
      "env": {
        "APP_VARIANT": "lite"
      }
    },
    "production-full": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleFullRelease"
      },
      "env": {
        "APP_VARIANT": "full"
      }
    },
    "production-prod": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProdRelease"
      },
      "env": {
        "APP_VARIANT": "prod"
      }
    }
  }
}
