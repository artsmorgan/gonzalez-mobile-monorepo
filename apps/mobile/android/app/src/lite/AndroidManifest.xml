<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Rastreo de ubicación para el mapa de Guardify con la app en segundo plano: servicio en primer plano de expo-location (notificación fija).
    Se declara SOLO en la variante `lite` (pruebas): `full` y `prod` no cambian sus permisos. No se necesita ACCESS_BACKGROUND_LOCATION: el servicio
    de tipo ubicación se arranca con la app visible. Si el sistema no deja arrancarlo, la app sigue rastreando solo con la pantalla abierta.
    Justificación en android-permissions.json (soloVarianteLite).
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
</manifest>
